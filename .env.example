# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ===== PostgreSQL (app database) =====
POSTGRES_PASSWORD=change-me

# ===== PostgreSQL (Keycloak database) =====
KEYCLOAK_DB_PASSWORD=change-me

# ===== Keycloak =====
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Full public URL (scheme + host + port) that Keycloak reports as its issuer.
# Run certs/generate-self-signed.sh with this same host/IP first, so the
# self-signed cert's SAN list matches. Example: https://203.0.113.10:1001
KC_HOSTNAME=https://your-domain-or-ip:1001

KEYCLOAK_REALM=tour-management
KEYCLOAK_CLIENT_ID=tour-backend
KEYCLOAK_CLIENT_SECRET=change-me

# Password for certs/truststore.jks generated by generate-self-signed.sh
TRUSTSTORE_PASSWORD=changeit
